# ========================================
# SERVER CONFIGURATION
# ========================================
PORT=5000
NODE_ENV=development

# ========================================
# MYSQL / MARIADB DATABASE
# ========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shop_sphere
DB_USER=root
DB_PASSWORD=

# If your database user has a password,
# enter it after DB_PASSWORD=.

# ========================================
# JWT AUTHENTICATION
# ========================================
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Replace JWT_SECRET with a strong, unique secret
# before running the application outside development.

# ========================================
# SMTP / EMAIL CONFIGURATION
# ========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASSWORD=replace_with_your_email_app_password
SMTP_FROM="ShopSphere <your_email@example.com>"